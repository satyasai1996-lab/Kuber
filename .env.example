# Kuber laptop-first deployment. Copy to .env locally; never commit .env.
KUBER_ENVIRONMENT=production
KUBER_API_TOKEN=replace-with-a-long-random-token

# Set only after obtaining a real public HTTPS domain and ISP static IPv4.
KUBER_PUBLIC_BASE_URL=https://api.example.com
KUBER_ANGEL_ONE_STATIC_IPV4=
KUBER_ANGEL_ONE_API_KEY=
KUBER_ANGEL_ONE_CALLBACK_URL=https://api.example.com/auth/angelone/callback
KUBER_ANGEL_ONE_POSTBACK_URL=https://api.example.com/webhooks/angelone/orders
KUBER_ENABLE_LIVE_ORDERS=false

# Configure these only on the Kuber backend after creating a user-owned Kite
# Connect app. They are never sent to the Android client or stored in the APK.
KUBER_ZERODHA_API_KEY=
KUBER_ZERODHA_API_SECRET=
KUBER_ZERODHA_REDIRECT_URL=https://api.example.com/brokers/zerodha/callback

# ChatGPT decision service. Keep this only in the backend environment; never
# add it to Android resources, source control, or an APK.
OPENAI_API_KEY=
KUBER_OPENAI_MODEL=gpt-5

# The optional Zerodha sandbox is developer-only. A real Kite account must use
# the user-owned production OAuth configuration above.
