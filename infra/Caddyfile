# Kuber HTTPS reverse proxy. Start Caddy with KUBER_PUBLIC_HOST set to a
# public DNS name; never forward Internet traffic directly to FastAPI :8000.
{
    email {$KUBER_ACME_EMAIL}
}

{$KUBER_PUBLIC_HOST} {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }
}
